<Window x:Class="ScreenTimer.Ui.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zbliża się koniec sesji"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Background="{DynamicResource Card}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScreenTimer;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#FFFFB74D" BorderThickness="2" Padding="22">
        <StackPanel Width="360">
            <TextBlock Text="Zbliża się koniec sesji" FontSize="20" FontWeight="SemiBold"
                       Foreground="#FFFFB74D" />
            <TextBlock x:Name="Body" FontSize="16" Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="Zapisz zmiany we wszystkich otwartych programach, zanim ekran zostanie zablokowany."
                       FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="OK, rozumiem" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="18,8"
                    HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnDismiss" />
        </StackPanel>
    </Border>
</Window>

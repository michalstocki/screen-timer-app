<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Backdrop" Color="#FF0E1217" />
    <SolidColorBrush x:Key="Card" Color="#FF1A2029" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F5F7" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF9AA5B1" />
    <SolidColorBrush x:Key="Accent" Color="#FF7DD3A8" />
    <SolidColorBrush x:Key="Danger" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Field" Color="#FF242C37" />

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#FF2D6CDF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FF2E3744" />
    </Style>

    <Style x:Key="CodeBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="#FF3B4656" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>

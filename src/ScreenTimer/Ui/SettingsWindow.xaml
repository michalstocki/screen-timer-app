<Window x:Class="ScreenTimer.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limit czasu przy komputerze – ustawienia"
        SizeToContent="Height" Width="460" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Backdrop}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScreenTimer;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,3" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Field}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="#FF3B4656" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,16">
        <TextBlock Text="Konta objęte limitem" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Note}"
                   Text="Aplikacja liczy czas i blokuje ekran tylko na zaznaczonych kontach." />

        <Border Background="{StaticResource Card}" CornerRadius="6" Padding="12,4" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}"
                                      ToolTip="{Binding Sid}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="AccountsNote" Style="{StaticResource Note}"
                   Text="Limit chroni konta standardowe. Nie zaznaczaj własnego konta administratora, jeśli nie chcesz sam dostawać blokady." />

        <TextBlock Text="Czasy" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sesja (min)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SessionBox" Style="{StaticResource NumberBox}"
                     AutomationProperties.Name="Czas sesji w minutach" />

            <TextBlock Grid.Row="0" Grid.Column="3" Text="Przerwa (min)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="4" x:Name="BreakBox" Style="{StaticResource NumberBox}"
                     AutomationProperties.Name="Czas przerwy w minutach" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ostrzeżenie (min)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WarningBox" Style="{StaticResource NumberBox}"
                     ToolTip="Ile minut przed końcem sesji pokazać ostrzeżenie; 0 wyłącza"
                     AutomationProperties.Name="Ostrzeżenie w minutach" />

            <TextBlock Grid.Row="1" Grid.Column="3" Text="Przedłużenia (min)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="4" x:Name="ExtensionsBox" Style="{StaticResource NumberBox}"
                     ToolTip="Minuty oddzielone przecinkami, np. 5, 10, 15"
                     AutomationProperties.Name="Długości przedłużeń w minutach" />
        </Grid>
        <TextBlock Style="{StaticResource Note}"
                   Text="Ostrzeżenie: ile minut przed końcem sesji pokazać okno (0 wyłącza); wyjście w tym czasie od razu zaczyna przerwę. Przedłużenia: minuty oddzielone przecinkami. Trwające odliczanie się nie zmienia, nowe wartości działają od następnej sesji lub przerwy." />

        <TextBlock Text="Kod blokady ekranu" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
        <Border Background="{StaticResource Card}" CornerRadius="6" Padding="12,8" Margin="0,6,0,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="CodeButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        FontSize="13" Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Center"
                        Click="OnChangeCode" />
                <TextBlock x:Name="CodeStatus" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="Message" FontSize="13" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zamknij" Style="{StaticResource SecondaryButton}" FontSize="14" Padding="16,6"
                    Click="OnClose" />
            <Button x:Name="SaveButton" Content="Zapisz" Style="{StaticResource PrimaryButton}" FontSize="14"
                    Padding="16,6" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="ScreenTimer.Ui.CodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kod blokady ekranu"
        SizeToContent="Height" Width="380" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScreenTimer;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,16">
        <TextBlock x:Name="Hint" FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

        <TextBlock Text="Nowy kod" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,12,0,4" />
        <PasswordBox x:Name="NewCode" Style="{StaticResource CodeBox}" FontSize="16" Padding="10,5"
                     HorizontalContentAlignment="Left" AutomationProperties.Name="Nowy kod" />

        <TextBlock Text="Powtórz kod" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,10,0,4" />
        <PasswordBox x:Name="RepeatCode" Style="{StaticResource CodeBox}" FontSize="16" Padding="10,5"
                     HorizontalContentAlignment="Left" AutomationProperties.Name="Powtórz kod" />

        <TextBlock x:Name="Message" FontSize="13" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anuluj" Style="{StaticResource SecondaryButton}" FontSize="14" Padding="16,6"
                    IsCancel="True" />
            <Button Content="Zapisz kod" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="16,6"
                    IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
